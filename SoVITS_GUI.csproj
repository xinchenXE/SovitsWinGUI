<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SoVITS_GUI</RootNamespace>
    <ApplicationIcon>img\app_icon.ico</ApplicationIcon>
    <AssemblyName>SoVITS_GUI</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 编译/发布输出目录：bin\$(Configuration)\WinUINet\x64（Release 时为 bin\Release\WinUINet\x64） -->
    <OutputPath>$(ProjectDir)bin\$(Configuration)\WinUINet\x64\</OutputPath>
    <PublishDir>$(ProjectDir)bin\$(Configuration)\WinUINet\x64\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="System.Management" Version="9.0.4" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="img\1e17595441e50a79b4c31c6bae9e3880_8036775604872242697.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="img\app_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyMissingPublishFiles" AfterTargets="Publish">
    <!-- WinUI 3 publish 默认不复制 .xbf (XAML编译产物) 和 .pri (资源索引)，运行时必需 -->
    <ItemGroup>
      <XbfFiles Include="$(OutputPath)*.xbf" />
      <XbfFiles Include="$(OutputPath)*.pri" />
      <PageXbfFiles Include="$(OutputPath)Pages\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(XbfFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(PublishDir)Pages" />
    <Copy SourceFiles="@(PageXbfFiles)" DestinationFolder="$(PublishDir)Pages\" SkipUnchangedFiles="true" />
    <!-- 图片 -->
    <MakeDir Directories="$(PublishDir)img" />
    <Copy SourceFiles="img\1e17595441e50a79b4c31c6bae9e3880_8036775604872242697.png;img\app_icon.ico"
          DestinationFolder="$(PublishDir)img\"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
