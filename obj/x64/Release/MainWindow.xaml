<Window
    x:Class="SoVITS_GUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SoVITS_GUI"
    xmlns:pages="using:SoVITS_GUI.Pages"
    Title="So-VITS-SVC — 启动器">

    <Grid>
        <NavigationView x:ConnectionId='2'
            x:Name="NavView"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            CompactPaneLength="48"
            OpenPaneLength="240"
                                                       
                                           
                                           >

            <!-- 头部 — 应用标识（图标 + 名称），对齐 Win11 设置侧边栏头部 -->
            <NavigationView.PaneHeader>
                <Grid Padding="14,10" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="6"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            VerticalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE8D6;"
                                  FontSize="15" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="So-VITS-SVC" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="歌声转换启动器" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <!-- 导航菜单 -->
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="home" Content="主页">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="preprocess" Content="预处理">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE70F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="training" Content="模型训练">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="inference" Content="推理转换">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE720;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="advanced" Content="高级工具">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="settings" Content="设置">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="log" Content="运行日志">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 底部：亮暗切换（导航项样式） -->
            <NavigationView.PaneFooter>
                <Button x:ConnectionId='3' x:Name="DarkModeBtn"
                                              
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        Padding="16,10"
                        Margin="4,0,4,12"
                        ToolTipService.ToolTip="亮暗切换">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon x:ConnectionId='4' x:Name="DarkModeIcon"
                                  FontFamily="{StaticResource FluentIconFont}"
                                  Glyph="&#xE706;"
                                  FontSize="15"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:ConnectionId='5' x:Name="DarkModeLabel"
                                   Text="亮暗切换"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </NavigationView.PaneFooter>

            <!-- 右侧内容区域 -->
            <NavigationView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Frame x:ConnectionId='6' x:Name="ContentFrame" Grid.Row="0" />

                    <!-- 底部状态栏：系统监控 -->
                    <Border
                        Grid.Row="1"
                        Padding="28,10"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="36">
                            <!-- CPU -->
                            <StackPanel Width="168" Spacing="4">
                                <Grid>
                                    <TextBlock Text="CPU" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:ConnectionId='17' x:Name="CpuText" Text="0%" FontSize="11"
                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar x:ConnectionId='15' x:Name="CpuBar" Value="0" Maximum="100"
                                             Style="{StaticResource KawaiiProgressBar}" />
                                <TextBlock x:ConnectionId='16' x:Name="CpuModelText" Text="" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- GPU -->
                            <StackPanel Width="168" Spacing="4">
                                <Grid>
                                    <TextBlock Text="GPU" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:ConnectionId='14' x:Name="GpuPercentText" Text="0%" FontSize="11"
                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar x:ConnectionId='11' x:Name="GpuBar" Value="0" Maximum="100"
                                             Style="{StaticResource KawaiiProgressBar}" />
                                <TextBlock x:ConnectionId='12' x:Name="GpuVramText" Text="" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:ConnectionId='13' x:Name="GpuModelText" Text="" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- 内存 -->
                            <StackPanel Width="168" Spacing="4">
                                <Grid>
                                    <TextBlock Text="内存" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:ConnectionId='10' x:Name="MemText" Text="0%" FontSize="11"
                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar x:ConnectionId='8' x:Name="MemBar" Value="0" Maximum="100"
                                             Style="{StaticResource KawaiiProgressBar}" />
                                <TextBlock x:ConnectionId='9' x:Name="MemModelText" Text="" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- 盘符（动态生成） -->
                            <StackPanel x:ConnectionId='7' x:Name="DiskPanel" Orientation="Horizontal" Spacing="36" />
                        </StackPanel>
                    </Border>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>

