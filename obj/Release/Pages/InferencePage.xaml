<Page
    x:Class="SoVITS_GUI.Pages.InferencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28,40,32">

            <!-- 页面标题 -->
            <TextBlock Text="推理转换" Style="{StaticResource PageHeaderStyle}" />
            <TextBlock Text="上传音频，选择目标角色，一键完成歌声转换"
                       Style="{StaticResource PageSubtitleStyle}" />

            <!-- 当前项目 -->
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingsRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingsIconBox}">
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE8B7;" FontSize="15"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="当前项目路径" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="可在设置页面中修改" Style="{StaticResource SettingsRowSubtitle}" />
                    </StackPanel>
                    <TextBox x:ConnectionId='23' x:Name="ProjectPathBox" Grid.Column="2" Style="{StaticResource KawaiiTextBox}"
                             MinWidth="420" PlaceholderText="请在设置页面中配置项目路径" IsReadOnly="True" />
                </Grid>
            </Border>

            <!-- 模型配置 -->
            <TextBlock Text="模型配置" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <!-- 配置文件 -->
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsIconBox}">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE838;" FontSize="15"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="配置文件" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text="base.yaml，模型结构与音频参数" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox x:ConnectionId='21' x:Name="ConfigPathBox" Style="{StaticResource KawaiiTextBox}" MinWidth="330"
                                     Text="configs/base.yaml" PlaceholderText="配置文件路径" />
                            <Button x:ConnectionId='22' x:Name="BrowseConfigBtn" Style="{StaticResource SecondaryButtonStyle}"
                                                              >
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE838;" FontSize="13" />
                                    <TextBlock Text="浏览" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsRowDivider}" />

                    <!-- 模型文件 -->
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsIconBox}">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE838;" FontSize="15"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="模型文件" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text=".pth 推理模型，可在高级工具页导出" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox x:ConnectionId='19' x:Name="ModelPathBox" Style="{StaticResource KawaiiTextBox}" MinWidth="330"
                                     Text="sovits5.0.pth" PlaceholderText="模型文件路径" />
                            <Button x:ConnectionId='20' x:Name="BrowseModelBtn" Style="{StaticResource SecondaryButtonStyle}"
                                                             >
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE838;" FontSize="13" />
                                    <TextBlock Text="浏览" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 目标角色 -->
            <TextBlock Text="目标角色" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <!-- 角色目录 -->
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsIconBox}">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE8B7;" FontSize="15"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="角色文件目录" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text="存放角色 .npy 音色嵌入的目录" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox x:ConnectionId='17' x:Name="SpeakerDirBox" Style="{StaticResource KawaiiTextBox}" MinWidth="330"
                                     PlaceholderText="选择角色 .npy 文件所在目录..." IsReadOnly="True" />
                            <Button x:ConnectionId='18' x:Name="BrowseSpeakerDirBtn" Style="{StaticResource SecondaryButtonStyle}"
                                                                  >
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE838;" FontSize="13" />
                                    <TextBlock Text="浏览" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsRowDivider}" />

                    <!-- 角色选择 -->
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsIconBox}">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE77B;" FontSize="15"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="选择角色" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text="目标音色" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <ComboBox x:ConnectionId='16' x:Name="SpeakerBox" Grid.Column="2" Style="{StaticResource KawaiiComboBox}"
                                  MinWidth="330" IsEditable="True" PlaceholderText="请先选择角色目录..." />
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsRowDivider}" />

                    <!-- 变调 -->
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsIconBox}">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE8D6;" FontSize="15"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="变调" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text="Pitch Shift，按半音调整" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" MinWidth="330" Spacing="2" VerticalAlignment="Center">
                            <Slider x:ConnectionId='14' x:Name="PitchShiftSlider" Minimum="-24" Maximum="24" Value="0"
                                    StepFrequency="1" TickFrequency="4" TickPlacement="Outside"
                                    IsThumbToolTipEnabled="True" />
                            <TextBlock x:ConnectionId='15' x:Name="PitchShiftLabel" Text="当前：0 半音（原调）" FontSize="11"
                                       HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsRowDivider}" />

                    <!-- Whisper 版本 -->
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsIconBox}">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE898;" FontSize="15"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Whisper 推理脚本" Style="{StaticResource SettingsRowTitle}" />
                            <!-- 本仓库 whisper/audio.py 为 128-mel 前端，旧的 inference.py（80mel）选项与其不兼容，故移除 -->
                            <TextBlock Text="如遇 mel 通道数错误，请切换版本" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <ComboBox x:ConnectionId='13' x:Name="WhisperVersionBox" Grid.Column="2"
                                  Style="{StaticResource KawaiiComboBox}" MinWidth="330" SelectedIndex="0">
                            <ComboBoxItem Content="inferencev3.py（推荐，128mel，适配 Large-v3）" />
                            <ComboBoxItem Content="inferencev2.py（128mel，适配 Large-v2）" />
                        </ComboBox>
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsRowDivider}" />

                    <!-- 特征检索 -->
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsIconBox}">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE721;" FontSize="15"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="特征检索" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text="提升音质与音色稳定性，需先构建索引" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <CheckBox x:ConnectionId='12' x:Name="EnableRetrievalBox" Grid.Column="2"
                                  Content="启用特征检索" IsChecked="False" FontSize="13"
                                  VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 输入音频 -->
            <TextBlock Text="输入音频" Style="{StaticResource SectionHeaderStyle}" />
            <Border x:ConnectionId='2' x:Name="AudioDropZone" Height="132" CornerRadius="8"
                    AllowDrop="True"                                                            
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Rectangle StrokeDashArray="4 3" StrokeThickness="1.2" RadiusX="7" RadiusY="7"
                               Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                               IsHitTestVisible="False" Margin="5" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE898;" FontSize="24"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock x:ConnectionId='10' x:Name="DropHintText" Text="拖拽音频文件到此处，或点击下方按钮选择"
                                   FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:ConnectionId='11' x:Name="SelectAudioBtn" Style="{StaticResource KawaiiPrimaryButton}"
                                                          HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE838;" FontSize="13" />
                                <TextBlock Text="选择音频文件" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 执行 -->
            <TextBlock Text="执行" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingsRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingsIconBox}">
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE768;" FontSize="15"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="开始转换" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock x:ConnectionId='9' x:Name="InferResultText" Text="转换结果将保存为 svc_out.wav"
                                   Style="{StaticResource SettingsRowSubtitle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:ConnectionId='7' x:Name="StartInferBtn" Style="{StaticResource KawaiiPrimaryButton}"
                                                        >
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE768;" FontSize="13" />
                                <TextBlock Text="开始" />
                            </StackPanel>
                        </Button>
                        <Button x:ConnectionId='8' x:Name="StopInferBtn" Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="False"                        >
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE71A;" FontSize="13" />
                                <TextBlock Text="停止" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 转换结果 -->
            <Border x:ConnectionId='3' x:Name="ResultCard" Style="{StaticResource SettingsCardPadded}" Margin="0,8,0,0"
                    Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="转换结果" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:ConnectionId='4' x:Name="ResultPathText" Text="" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <!-- 转换结果试听 -->
                    <MediaPlayerElement x:ConnectionId='5' x:Name="ResultPlayer" AreTransportControlsEnabled="True"
                                        AutoPlay="False" MaxHeight="90" />
                    <Button x:ConnectionId='6' x:Name="SaveResultBtn" Style="{StaticResource KawaiiPrimaryButton}"
                                                     HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE105;" FontSize="13" />
                            <TextBlock Text="保存音频到..." />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

