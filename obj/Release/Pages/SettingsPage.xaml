<Page
    x:Class="SoVITS_GUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28,40,32">

            <!-- 页面标题 -->
            <TextBlock Text="设置" Style="{StaticResource PageHeaderStyle}" />
            <TextBlock Text="配置应用运行参数" Style="{StaticResource PageSubtitleStyle}" />

            <!-- Conda 虚拟环境 -->
            <TextBlock Text="Conda 虚拟环境" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCardPadded}">
                <StackPanel Spacing="12">
                    <TextBlock Text="选择项目使用的 Conda 虚拟环境（需已安装 Anaconda/Miniconda）"
                               Style="{StaticResource SettingsRowSubtitle}" />

                    <!-- 自动检测行 -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:ConnectionId='17' x:Name="CondaEnvBox" Grid.Column="0"
                                  Style="{StaticResource KawaiiComboBox}"
                                  PlaceholderText="点击右侧按钮检测 Conda 环境..."
                                                                                 
                                  HorizontalAlignment="Stretch" MaxWidth="560" />
                        <Button x:ConnectionId='18' x:Name="RefreshCondaBtn" Grid.Column="1"
                                Style="{StaticResource KawaiiPrimaryButton}"
                                                          >
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock Text="检测" />
                            </StackPanel>
                        </Button>
                        <Button x:ConnectionId='19' x:Name="BrowseCondaBtn" Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                                         >
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE838;" FontSize="13" />
                                <TextBlock Text="手动选择" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 手动指定路径行（默认隐藏，手动选择后显示） -->
                    <Border x:ConnectionId='9' x:Name="ManualPathPanel" Background="{StaticResource LightMintBrush}"
                            CornerRadius="6" Padding="12,10" Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="当前使用手动指定的环境" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource MintGreenBrush}" />
                                <TextBlock x:ConnectionId='15' x:Name="ManualPathText" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:ConnectionId='16' x:Name="ManualPythonText" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:ConnectionId='14' x:Name="ClearManualBtn" Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                                              VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE711;" FontSize="13" />
                                    <TextBlock Text="取消" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border x:ConnectionId='10' Background="{StaticResource LightMintBrush}" CornerRadius="6"
                            Padding="12,10" Visibility="Collapsed" x:Name="EnvInfoPanel">
                        <StackPanel Spacing="4">
                            <TextBlock x:ConnectionId='11' x:Name="EnvNameText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource MintGreenBrush}" />
                            <TextBlock x:ConnectionId='12' x:Name="EnvPathText" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:ConnectionId='13' x:Name="EnvPythonText" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                        <TextBlock.Text>
                            提示：选择 Conda 环境后，所有 Python 脚本将在该环境中运行。手动选择的路径优先于自动检测。点击"取消"可恢复自动检测。
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 项目路径 -->
            <TextBlock Text="项目路径" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsIconBox}">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE8B7;" FontSize="15"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="So-VITS-SVC 项目根目录" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text="训练与推理脚本均在该目录下运行" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox x:ConnectionId='7' x:Name="DefaultProjectPathBox" Style="{StaticResource KawaiiTextBox}"
                                     MinWidth="330" PlaceholderText="默认为应用所在目录" IsReadOnly="True" />
                            <Button x:ConnectionId='8' x:Name="BrowseDefaultProjectBtn" Style="{StaticResource SecondaryButtonStyle}"
                                                                      >
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE838;" FontSize="13" />
                                    <TextBlock Text="浏览" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsRowDivider}" />
                    <!-- 项目路径有效性提示：由代码根据是否检测到关键项目文件更新 -->
                    <TextBlock x:ConnectionId='6' x:Name="ProjectValidHint" Text="未设置项目路径" FontSize="12"
                               Margin="16,10" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 日志设置 -->
            <TextBlock Text="日志设置" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="自动滚动" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text="收到新日志时自动滚动到底部" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <CheckBox x:ConnectionId='5' x:Name="AutoScrollBox" Grid.Column="1" IsChecked="True"
                                                                                                   
                                  VerticalAlignment="Center" />
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsRowDivider}" />
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="显示时间戳" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text="在每条日志前显示时间" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <CheckBox x:ConnectionId='4' x:Name="ShowTimestampBox" Grid.Column="1" IsChecked="True"
                                                                                                         
                                  VerticalAlignment="Center" />
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsRowDivider}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="16,12">
                        <Button x:ConnectionId='2' x:Name="SaveLogBtn" Style="{StaticResource KawaiiPrimaryButton}"
                                                     >
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE105;" FontSize="13" />
                                <TextBlock Text="保存日志" />
                            </StackPanel>
                        </Button>
                        <Button x:ConnectionId='3' x:Name="ClearLogBtn" Style="{StaticResource SecondaryButtonStyle}"
                                                      >
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE74D;" FontSize="13" />
                                <TextBlock Text="清空日志" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <TextBlock Text="关于" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingsRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingsIconBox}">
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE946;" FontSize="15"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="So-VITS-SVC 启动器" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <!-- 关于文案：仓库名做成可点击超链接，跳转到兼容的 GitHub 项目 -->
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="版本 v1.0.0 — 本项目兼容 " /><Hyperlink NavigateUri="https://github.com/ShadowLoveElysia/Whisper-vits-svc-LargeV3"><Run Text="ShadowLoveElysia/Whisper-vits-svc-LargeV3" /></Hyperlink>
                        </TextBlock>
                        <TextBlock Text="技术栈：C# / .NET 10 / WinUI 3 / Windows App SDK 2.3.1"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

