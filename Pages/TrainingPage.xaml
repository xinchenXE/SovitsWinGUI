<Page
    x:Class="SoVITS_GUI.Pages.TrainingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28,40,32">

            <!-- 页面标题 -->
            <TextBlock Text="模型训练" Style="{StaticResource PageHeaderStyle}" />
            <TextBlock Text="设置训练参数并启动 So-VITS 模型训练"
                       Style="{StaticResource PageSubtitleStyle}" />

            <!-- 当前项目 -->
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingsRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingsIconBox}">
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE8B7;" FontSize="15"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="当前项目路径" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock x:Name="ProjectPathLabel" Text="" Style="{StaticResource SettingsRowSubtitle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 训练超参数 -->
            <TextBlock Text="训练超参数" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <!-- 模型名称 -->
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsIconBox}">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE70F;" FontSize="15"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="模型名称" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text="检查点将保存到 chkpt\模型名称\ 目录"
                                       Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <TextBox x:Name="ModelNameBox" Grid.Column="2" Style="{StaticResource KawaiiTextBox}"
                                 MinWidth="320" Text="sovits5.0" PlaceholderText="输入模型名称..." />
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsRowDivider}" />

                    <!-- 学习率 -->
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsIconBox}">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE9D2;" FontSize="15"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="学习率" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text="Learning Rate，非法值将拦截启动" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <TextBox x:Name="LearningRateBox" Grid.Column="2" Style="{StaticResource KawaiiTextBox}"
                                 MinWidth="320" Text="5e-5" PlaceholderText="例如: 5e-5" />
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsRowDivider}" />

                    <!-- 批次大小 -->
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsIconBox}">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE90F;" FontSize="15"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="批次大小" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text="Batch Size，按显存容量选择" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" MinWidth="320" Spacing="2" VerticalAlignment="Center">
                            <Slider x:Name="BatchSizeSlider" Minimum="1" Maximum="16" Value="6"
                                    StepFrequency="1" TickFrequency="1" TickPlacement="Outside"
                                    IsThumbToolTipEnabled="True" />
                            <TextBlock x:Name="BatchSizeLabel" Text="当前：6（推荐 6G 显存）" FontSize="11"
                                       HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsRowDivider}" />

                    <!-- 预训练底模 -->
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsIconBox}">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE78C;" FontSize="15"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="预训练底模" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text="推荐开启，收敛更快" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <CheckBox x:Name="UsePretrainBox" Grid.Column="2"
                                  Content="使用预训练底模" IsChecked="True" FontSize="13"
                                  VerticalAlignment="Center" />
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsRowDivider}" />

                    <!-- 间隔设置 -->
                    <StackPanel Padding="16,12" Spacing="8">
                        <Grid ColumnSpacing="16" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="日志间隔 (step)" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="LogIntervalBox" Style="{StaticResource KawaiiTextBox}" Text="100"
                                         Width="220" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="保存间隔 (epoch)" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="SaveIntervalBox" Style="{StaticResource KawaiiTextBox}" Text="5"
                                         Width="220" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 执行 -->
            <TextBlock Text="执行" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <!-- 开始训练 -->
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsIconBox}">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE71D;" FontSize="15"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="开始训练" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text="启动前会检查训练清单与底模文件" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="StartTrainBtn" Style="{StaticResource KawaiiPrimaryButton}"
                                    Click="StartTrain_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE768;" FontSize="13" />
                                    <TextBlock Text="开始" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopTrainBtn" Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="False" Click="StopTrain_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE71A;" FontSize="13" />
                                    <TextBlock Text="停止" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsRowDivider}" />

                    <!-- TensorBoard -->
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsIconBox}">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE9D2;" FontSize="15"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="TensorBoard" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock Text="独立进程运行，不影响训练" Style="{StaticResource SettingsRowSubtitle}" />
                        </StackPanel>
                        <Button x:Name="TensorboardBtn" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                                Click="Tensorboard_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE9D2;" FontSize="13" />
                                <TextBlock x:Name="TensorboardBtnText" Text="启动 TensorBoard" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 恢复训练 -->
            <TextBlock Text="恢复训练" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCardPadded}">
                <StackPanel Spacing="10">
                    <TextBlock Text="从历史检查点继续训练。检查点位于 chkpt\模型名称\ 目录，训练过程中按保存间隔自动生成。"
                               Style="{StaticResource SettingsRowSubtitle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CheckpointBox" Grid.Column="0" Style="{StaticResource KawaiiComboBox}"
                                  PlaceholderText="未找到检查点" HorizontalAlignment="Stretch"
                                  MaxWidth="480" />
                        <Button x:Name="RefreshCkptBtn" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                Click="RefreshCkpt_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Button x:Name="ResumeTrainBtn" Style="{StaticResource KawaiiPrimaryButton}"
                            Click="ResumeTrain_Click" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE768;" FontSize="13" />
                            <TextBlock Text="恢复训练" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
